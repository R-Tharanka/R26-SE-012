
# Provide a service account JSON for the Firebase project and point to it.
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_RESULTS_COLLECTION=grading_forecast_results

# Hugging Face Hub runtime artifact storage.
# Use a private repository and provide the token through Railway/local env only.
HF_TOKEN=
HF_MODEL_REPO=
HF_MODEL_REVISION=main
HF_GRADING_MODEL_FILE=grading/berry_mobilenetv2_v2_best.onnx
HF_CLASS_NAMES_FILE=grading/class_names.json
HF_FORECAST_MODEL_FILE=forecasting/forecast_model.joblib
HF_FORECAST_METRICS_FILE=forecasting/naive_persistence_metrics.json
HF_FORECAST_DATA_FILE=forecasting/national_grade1_average_weekly.csv
